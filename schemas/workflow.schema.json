{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaleab-kali/vogon-runtime/main/schemas/workflow.schema.json",
  "title": "Vogon Workflow",
  "description": "TOML-compatible shape for Vogon Runtime workflow files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "steps"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "pointer", "allow", "deny"],
      "properties": {
        "step": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "allow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["max_step_output_bytes"]
        },
        {
          "required": ["allowed_providers"],
          "properties": {
            "allowed_providers": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["allowed_models"],
          "properties": {
            "allowed_models": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "allowed_providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_step_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    }
  }
}
